        <script type="text/javascript">
        var authorization = function() {
            var form_data = {
                login: $('#exampleLogin').val(),
                password: $('#examplePassword').val(),
                rememberme: $('#exampleRememberme').is(':checked') ? 1 : 0,
            };
            
            jsonRequest('/login', {data: JSON.stringify(form_data)}, function(r) {
                if( typeof(r.status) != 'undefined' && r.status == 'success' ) {
                    window.location.href = '/';
                } else if( typeof(r.status) != 'undefined' && r.status == 'error' ) {
                    alert('Ошибка: ' + r.data.errorText);
                }
            });
        };

        var registration = function() {
            var form_data = {
                login: $('#exampleRegLogin').val(),
                name: $('#exampleRegName').val(),
                pwd1: $('#exampleRegPwd1').val(),
                pwd2: $('#exampleRegPwd2').val(),
            };
            
            if( form_data.login == '' || form_data.name == '' ) {
                alert('все поля обязательны...');
                return;
            }

            if( form_data.pwd1 != form_data.pwd2 ) {
                alert('Пароли не совпадают...');
                return;
            }
            
            jsonRequest('/register', {data: JSON.stringify(form_data)}, function(r) {
                if( typeof(r.status) != 'undefined' && r.status == 'success' ) {
                    window.location.href = '/';
                } else if( typeof(r.status) != 'undefined' && r.status == 'error' ) {
                    alert('Ошибка: ' + r.data.errorText);
                }
            });
        };
        
        $(function(){
